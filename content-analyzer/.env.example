# comfly.chat AI 分析配置
# 请复制此文件为 .env 并填入您的实际配置

# API 密钥（从 comfly.chat 获取）
COMFLY_API_KEY=your_comfly_api_key_here

# API 基础 URL
COMFLY_BASE_URL=https://ai.comfly.chat/v1

# 使用的模型
COMFLY_MODEL=gpt-5.4

# 其他配置
DEBUG=true
API_TOKEN=replace_with_a_strong_token
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HEADLESS=false
CHROME_ATTACH_EXISTING=false
CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222

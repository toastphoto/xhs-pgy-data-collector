{
  "version": "pgy_v1_default",
  "platform": "pgy",
  "mode": "safe_dom",
  "resolveNoteUrlByClick": false,
  "tabTexts": ["数据概览", "笔记数据", "粉丝分析"],
  "pages": [
    { "name": "creator_detail", "tabText": null },
    { "name": "overview", "tabText": "数据概览" },
    { "name": "notes", "tabText": "笔记数据" },
    { "name": "fans", "tabText": "粉丝分析" }
  ],
  "candidate_search": {
    "rowSelector": null,
    "nameSelector": null,
    "paginationSelector": null
  },
  "noteCardSelector": null,
  "creator_summary": [
    { "name": "platform", "selector": null, "value": "pgy" },
    { "name": "creator_name", "selector": ".blogger-base-info .blogger-name", "transform": "text" },
    { "name": "creator_url", "selector": null, "transform": "url" },
    { "name": "followers", "selector": null, "transform": "number" }
  ],
  "note_detail": [
    { "name": "note_title", "selector": "[class*='title'],h3,h4", "transform": "text" },
    { "name": "note_url", "selector": "a[href*='/explore/']", "attr": "href", "transform": "url" }
  ]
}
